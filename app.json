{
  "expo": {
    "name": "Jetsona",
    "slug": "jetsona-console",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "jetsona",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080c12",
    "ios": {
      "bundleIdentifier": "cloud.protexa.jetsona.console",
      "supportsTablet": true,
      "requireFullScreen": true,
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Jetsona cần truy cập mạng nội bộ để truyền hình ảnh và điều khiển máy tính ở nhà.",
        "NSBluetoothAlwaysUsageDescription": "Jetsona dùng Bluetooth để nhận tay cầm, bàn phím và chuột khi chơi game từ xa.",
        "GCSupportsControllerUserInteraction": true,
        "GCSupportedGameControllers": [
          {
            "ProfileName": "ExtendedGamepad"
          }
        ]
      }
    },
    "android": {
      "package": "cloud.protexa.jetsona.console",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#080c12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080c12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-jetsona-android",
      "./plugins/with-jetsona-ios",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jetsona cần chọn ảnh gameplay để thiết lập vị trí các nút điều khiển.",
          "cameraPermission": false,
          "microphonePermission": "Bộ âm thanh của luồng stream mở đường âm thanh hai chiều. Jetsona không ghi âm và không gửi giọng nói của bạn."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bộ âm thanh của luồng stream mở đường âm thanh hai chiều. Jetsona không ghi âm và không gửi giọng nói của bạn.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "backendBaseUrl": "https://vn.protexa.cloud",
      "supabaseAnonKey": "sb_publishable_-QsnqGoqBAspgJOSGXM1rX_N1hlwRkN",
      "router": {},
      "eas": {
        "projectId": "95c0822b-af7c-4b00-a3d5-1ca1b7023246"
      }
    },
    "owner": "dathuynh_coolest"
  }
}
