@@ -19,6 +19,41 @@
 #import "RTCVideoViewManager.h"
 #import "WebRTCModule.h"
 
+/**
+ * RTCMTLVideoView skips any frame whose timeStampNs equals the last frame it
+ * drew. Remote tracks rendered with zero playout delay stamp every decoded
+ * frame with the same render time, so the view kept the first frame on screen
+ * while the decoder went on decoding. Restamp repeats so every frame is drawn.
+ */
+@interface RTCVideoViewFrameStamper : NSObject<RTCVideoRenderer>
+
+@property(nonatomic, weak) id<RTCVideoRenderer> target;
+
+@end
+
+@implementation RTCVideoViewFrameStamper {
+    int64_t _lastTimeStampNs;
+}
+
+- (void)setSize:(CGSize)size {
+    [self.target setSize:size];
+}
+
+- (void)renderFrame:(nullable RTCVideoFrame *)frame {
+    if (!frame) {
+        return;
+    }
+    int64_t timeStampNs = frame.timeStampNs;
+    if (timeStampNs <= _lastTimeStampNs) {
+        timeStampNs = _lastTimeStampNs + 1;
+        frame = [[RTCVideoFrame alloc] initWithBuffer:frame.buffer rotation:frame.rotation timeStampNs:timeStampNs];
+    }
+    _lastTimeStampNs = timeStampNs;
+    [self.target renderFrame:frame];
+}
+
+@end
+
 /**
  * Implements an equivalent of {@code HTMLVideoElement} i.e. Web's video
